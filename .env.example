# ==========================================
# Hassbulla Bot - Environment Configuration
# ==========================================

# Discord Bot Credentials (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
GUILD_ID=your_development_guild_id_here

# Role IDs
STAFF_ROLE_ID=your_staff_role_id
BOOSTER_ROLE_ID=your_server_booster_role_id
STREAMER_ROLE_ID=your_streamer_role_id
VERIFIED_ROLE_ID=your_verified_role_id

# Channel IDs for Logging & Moderation
VOICE_LOGS_CHANNEL_ID=your_voice_logs_channel_id
MOD_LOGS_CHANNEL_ID=your_mod_logs_channel_id
HONEYPOT_CHANNEL_ID=your_honeypot_channel_id
TICKETS_LOGS_CHANNEL_ID=your_tickets_logs_channel_id

# Dynamic Voice Channel Configuration
VOICE_CREATOR_CHANNEL_ID=your_join_to_create_channel_id
TEMP_VOICE_CATEGORY_ID=your_temp_voice_category_id

# Community & Content Creator Channels
DIRECTOS_CHANNEL_ID=your_live_announcements_channel_id
VIDEOS_CHANNEL_ID=your_videos_announcements_channel_id

# AI Providers Configuration (Anthropic Claude / Gemini / Groq)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Keys (Supports multi-key pool for load-balancing and failover)
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY1=your_groq_api_key_1
GROQ_API_KEY2=your_groq_api_key_2
GROQ_API_KEY3=your_groq_api_key_3
